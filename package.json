{
  "name": "benchmark-pwa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "quality:ci": "npm run lint && npm run typecheck && npm run test",
    "import:benches:parse": "node scripts/bench-importer/import-benches.js",
    "import:benches:photos": "node scripts/bench-importer/fetch-photos.js",
    "import:benches": "node scripts/import-benches-to-db.js",
    "import:benches:rename": "node scripts/bench-importer/rename-benches.js",
    "import:benches:types": "node scripts/bench-importer/normalize-bench-types.js",
    "email:test": "node scripts/send-test-email.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.3",
    "@types/leaflet": "^1.9.21",
    "@vercel/analytics": "^2.0.1",
    "csv-parse": "^7.0.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "next": "^15.3.0",
    "proj4": "^2.20.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "resend": "^6.18.0",
    "standardwebhooks": "^1.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.15.18",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "dotenv": "^17.4.2",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vitest": "^2.1.8"
  }
