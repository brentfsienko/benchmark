# Supabase (required for API + database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth (get anon key from Supabase Dashboard → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Or use the new publishable key: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Optional: override API base (default: /api/v1 for same-origin)
# NEXT_PUBLIC_BENCHMARK_API_BASE_URL=
NEXT_PUBLIC_BENCHMARK_CURRENT_USER_ID=user-1
