# Supabase (required for API + database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth (get anon key from Supabase Dashboard → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Or use the new publishable key: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Canonical site URL for auth email redirects (production)
NEXT_PUBLIC_SITE_URL=https://benchmark.rest

# Resend (auth emails via /api/auth/send-email hook)
RESEND_API_KEY=re_xxxxxxxxx
# Until domain is verified in Resend, leave unset to use onboarding@resend.dev
# RESEND_FROM_EMAIL=Benchmark <noreply@benchmark.rest>
# Inbox for “request benches in my area” emails from explore
# BENCH_REQUEST_TO_EMAIL=you@example.com
# Generated in Supabase → Authentication → Hooks → Send Email
SEND_EMAIL_HOOK_SECRET=v1,whsec_xxxxxxxxx

# Optional: override API base (default: /api/v1 for same-origin)
# NEXT_PUBLIC_BENCHMARK_API_BASE_URL=
NEXT_PUBLIC_BENCHMARK_CURRENT_USER_ID=user-1
